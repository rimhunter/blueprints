#!/usr/bin/env bash
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"
fail=0
check() { if "${@:2}" >/dev/null 2>&1; then echo "PASS $1"; else echo "FAIL $1"; fail=1; fi; }
upstream() { git show "v4.0.53:$1"; }

about_ok() {
  python3 -I - About/About.xml <<'PY'
import sys, xml.etree.ElementTree as ET
r = ET.parse(sys.argv[1]).getroot()
t = lambda p: r.findtext(p)
assert t("name") == "Blueprints (Continued)"
assert t("packageId") == "rimhunter.blueprints"
assert t("author") == "Fluffy, rimhunter"
assert t("modVersion") == "4.1.0"
assert t("url") == "https://github.com/rimhunter/blueprints"
assert [e.text for e in r.findall("supportedVersions/li")] == ["1.6", "1.7"]
assert [e.findtext("packageId") for e in r.findall("modDependencies/li")] == ["brrainz.harmony"]
assert sorted(e.text.lower() for e in r.findall("incompatibleWith/li")) == sorted(
    ["fluffy.blueprints", "fluffy.blueprints.fork", "defi.blueprints.fork", "dw.defi.fluffy.blueprints.fork"])
PY
}
license_unchanged() { upstream LICENSE | cmp - LICENSE; }
modifications_ok() {
  grep -qxF "Modifications Copyright 2026 rimhunter, under the same MIT and CC-BY-SA 4.0 terms" MODIFICATIONS
}
changelog_ok() {
  grep -qE '^- [0-9]{4}-[0-9]{2}-[0-9]{2}: ' CHANGELOG.md &&
  grep -q 'v4.0.53' CHANGELOG.md &&
  grep -qE '^## (Unreleased|[0-9]+\.[0-9]+\.[0-9]+ \([0-9]{4}-[0-9]{2}-[0-9]{2}\))' CHANGELOG.md &&
  ! grep -qE '^- [^0-9]' CHANGELOG.md
}
languages_ok() {
  python3 -I - "$here" <<'PY'
import sys, re, glob, os, subprocess, xml.etree.ElementTree as ET
root = sys.argv[1]
def git(*a): return subprocess.run(["git", "-C", root, *a], check=True, capture_output=True).stdout
def entries(xml):
    r = ET.fromstring(xml)
    return {e.tag: (e.text or "") for e in r}
old = {}
for path in git("ls-tree", "-r", "--name-only", "v4.0.53", "Languages").decode().split("\n"):
    if not path.endswith(".xml") or "HugsLib" in path: continue
    parts = path.split("/")
    lang = parts[1]
    if parts[2] == "DefInjected":
        k = (lang, "DefInjected", parts[3])
    else:
        k = (lang, "Keyed")
    old.setdefault(k, {}).update(entries(git("show", "v4.0.53:" + path)))
new = {}
for f in glob.glob(root + "/Languages/*/*/**/*.xml", recursive=True):
    parts = os.path.relpath(f, root).split("/")
    assert parts[2] in ("Keyed", "DefInjected"), "file outside a folder the game loads: " + f
    assert "HugsLib" not in f, f
    k = (parts[1], "DefInjected", parts[3]) if parts[2] == "DefInjected" else (parts[1], "Keyed")
    new.setdefault(k, {}).update(entries(open(f, "rb").read()))
for k, v in old.items():
    assert k in new, "lost " + str(k)
    for tag, text in v.items():
        assert new[k].get(tag) == text, "key lost or changed: %s %s" % (k, tag)
assert len({k[0] for k in old}) == 11
english = new[("English", "Keyed")]
used = set()
for f in glob.glob(root + "/Source/*.cs"):
    used |= set(re.findall(r'"([A-Za-z0-9_.]+)"\s*\.Translate', open(f).read()))
vanilla = {"ProblemSavingFile", "UnchosenStuff"}
assert not (used - vanilla - set(english)), sorted(used - vanilla - set(english))
PY
}
preview_ok() {
  python3 -I - "$here" <<'PY'
import sys, hashlib, subprocess, struct
root = sys.argv[1]
old = subprocess.run(["git", "-C", root, "show", "v4.0.53:About/Preview.png"], check=True, capture_output=True).stdout
new = open(root + "/About/Preview.png", "rb").read()
assert new[:8] == b"\x89PNG\r\n\x1a\n"
w, h = struct.unpack(">II", new[16:24])
assert w * 9 == h * 16 and w >= 640, (w, h)
assert len(new) < 1024 * 1024, len(new)
assert hashlib.sha256(old).digest() != hashlib.sha256(new).digest()
PY
}
copyright_ok() {
  python3 -I - "$here" <<'PY'
import sys, subprocess
root = sys.argv[1]
def git(*a): return subprocess.run(["git", "-C", root, *a], check=True, capture_output=True).stdout.decode("utf-8", "replace")
moved = {}
for line in git("diff", "-M", "--name-status", "v4.0.53", "--", "Source").splitlines():
    f = line.split("\t")
    if f[0].startswith("R"): moved[f[1]] = f[2]
    elif f[0] == "D": moved[f[1]] = None
checked = 0
for path in git("ls-tree", "-r", "--name-only", "v4.0.53", "Source").splitlines():
    lines = [l.strip() for l in git("show", "v4.0.53:" + path).splitlines() if "Copyright Karel Kroeze" in l]
    if not lines: continue
    target = moved.get(path, path)
    if target is None: continue
    current = {l.strip() for l in open(root + "/" + target, encoding="utf-8-sig", errors="replace").read().splitlines()}
    for l in lines:
        assert l in current, "%s: %s" % (target, l)
        checked += 1
assert checked >= 8, checked
PY
}
workshop_ok() {
  python3 -I - WORKSHOP.md <<'PY'
import sys, re
raw = open(sys.argv[1], encoding="utf-8").read()
assert raw.count("\n---\n") >= 1
body = raw.split("\n---\n", 1)[1]
for i, line in enumerate(body.split("\n")):
    assert not re.match(r"\s*(#{1,6}\s|[-*+]\s|\d+\.\s|>\s|```)", line), "markdown at line %d: %s" % (i, line)
assert "**" not in body and "](" not in body and "`" not in body and "__" not in body
tags = re.findall(r"\[(/?)([a-z0-9]+)(?:=[^\]]*)?\]", body)
allowed = {"h1", "h2", "h3", "b", "i", "u", "strike", "spoiler", "noparse", "hr", "url", "list", "olist", "quote", "code", "table", "tr", "th", "td", "img", "p", "*"}
stack = []
for close, name in tags:
    assert name in allowed, "unknown tag " + name
    if name in ("hr", "*"): continue
    if close:
        assert stack and stack.pop() == name, "unbalanced " + name
    else:
        stack.append(name)
assert not stack, stack
low = body.lower()
need = [
    "continuation of fluffy's blueprints",
    "https://steamcommunity.com/sharedfiles/filedetails/?id=708455313",
    "https://github.com/fluffy-mods/blueprints",
    "https://github.com/rimhunter/blueprints",
    "copyright 2020 fluffy",
    "mit",
    "cc-by-sa 4.0",
    "claims no ownership of the original",
    "taken down or handed back at fluffy's request",
    "accepts no donations",
    "untested in multiplayer",
    "unsubscribe",
    "fluffy.blueprints.fork", "defi.blueprints.fork", "dw.defi.fluffy.blueprints.fork",
    "blueprints - forked", "blueprints forked - 1.6", "blueprints1.6-temp",
    "blueprints - 1.7 waylith (unofficial)", "3819556044",
    "alpha prefabs",
    "not endorsed by ludeon",
]
for n in need:
    assert n.lower() in low, "missing: " + n
PY
}
package_ok() {
  local out rc=0; out="$(mktemp -d)"
  package_check "$out" || rc=1
  rm -rf "$out"
  return $rc
}
package_check() {
  local out="$1"
  scripts/package --no-build "$out/pkg" >/dev/null || return 1
  for p in About/About.xml About/Preview.png LICENSE MODIFICATIONS CHANGELOG.md Source/Blueprints.csproj Source/Mod.cs Source/Blueprint.psd \
           Languages/English/Keyed/Translations.xml Languages/PortugueseBrazilian/Keyed/Translations.xml; do
    [ -f "$out/pkg/$p" ] || { echo "missing $p"; return 1; }
  done
  for p in TestRunner Tests scripts WORKSHOP.md modinfo.json Readme.md Source/preview.svg; do
    [ -e "$out/pkg/$p" ] && { echo "unexpected $p"; return 1; }
  done
  local old; old="$(upstream About/Preview.png | sha256sum | cut -d' ' -f1)"
  while IFS= read -r f; do
    [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$old" ] && { echo "Fluffy's preview image is shipped as $f"; return 1; }
  done < <(find "$out/pkg" -type f)
  return 0
}
scenarios_ok() {
  local f; f="$(ls TestRunner/Source/Scenarios/Identity*.cs)" || return 1
  for id in Fluffy.Blueprints Fluffy.Blueprints.fork defi.blueprints.fork dw.defi.fluffy.blueprints.fork; do
    grep -rqF "$id" TestRunner/Fixtures $f || return 1
  done
  grep -q 'screenshot-mod-list-warns-when-fluffys-blueprints-is-also-enabled' $f
}
tree_clean() {
  [ ! -e modinfo.json ] && ! git ls-files | grep -qi 'preview.svg'
}

check "About.xml identity and incompatible list" about_ok
check "LICENSE unchanged from v4.0.53" license_unchanged
check "modifications notice" modifications_ok
check "CHANGELOG dated, names v4.0.53" changelog_ok
check "every language and key kept, none missing in English" languages_ok
check "Fluffy's copyright lines kept in Source" copyright_ok
check "own preview image, not Fluffy's" preview_ok
check "Workshop page is BBCode and says what it must" workshop_ok
check "package folder contents" package_ok
check "mod list warning scenarios" scenarios_ok
check "no personal email file or BY-NC preview source in the tree" tree_clean
exit $fail
