#!/usr/bin/env python3
import sys
from PIL import Image

CROP = (270, 233, 3470, 2033)
OUT = (1024, 576)

if len(sys.argv) != 3:
    sys.exit("usage: scripts/make-preview FULL_SIZE_SCREENSHOT.png About/Preview.png")
src = Image.open(sys.argv[1])
if src.size != (3840, 2160):
    sys.exit("expected the 3840x2160 full-size screenshot of screenshot-preview-image-source, got %dx%d" % src.size)
src.convert("RGB").crop(CROP).resize(OUT, Image.LANCZOS).save(sys.argv[2], optimize=True)
