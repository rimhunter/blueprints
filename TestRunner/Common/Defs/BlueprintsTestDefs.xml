<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>BlueprintsTest_EvenBench</defName>
        <label>blueprints test bench</label>
        <description>Test-only bench: two cells wide, cannot rotate, has an interaction cell.</description>
        <graphicData>
            <texPath>Things/Building/Production/TableButcher</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2,1)</drawSize>
        </graphicData>
        <size>(2,1)</size>
        <rotatable>false</rotatable>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.4</fillPercent>
        <pathCost>30</pathCost>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>400</WorkToBuild>
        </statBases>
        <costList>
            <Steel>10</Steel>
        </costList>
        <designationCategory>Furniture</designationCategory>
        <uiOrder>9990</uiOrder>
    </ThingDef>
</Defs>
